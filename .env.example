# CrossLLM 环境变量模板
#
# 用法：复制为 .env 后填入真实值。.env 已被 .gitignore 排除，不会进版本库。
#     copy .env.example .env
#
# 安全约定（phase2_real_llm.md §6/§8）：
#   - 密钥只存在于 .env 与 Provider 内存中，绝不写进代码 / config/*.yaml / 日志
#     / 会话文件 / API 响应。
#   - config/models.yaml 只写**变量名**（api_key_env: OPENROUTER_API_KEY），不写值。
#   - 不填任何值、只用 Mock Provider 时，应用也能正常启动。
#   - 系统环境变量优先：load_dotenv 内部使用 setdefault 语义，已存在的环境变量不被覆盖。
#
# 下面所有值都留空。**不要在模板文件里填写真实密钥**，否则它就随版本库发布了。

# ---- 真实模型 Provider（选 OpenRouter 时需要）----
# OpenRouter API Key，config/models.yaml 的 api_key_env 指向它。
OPENROUTER_API_KEY=

# ---- MCP Server 可选凭证（见 config/mcp.yaml）----
# GitHub MCP：由 .env 注入 os.environ，MCP 子进程继承，不写进 mcp.yaml。
GITHUB_PERSONAL_ACCESS_TOKEN=
# Context7：留空仍可连接，但更容易触发 rate limit。
CONTEXT7_API_KEY=
# Stack Overflow：留空仍可用，但 rate limit 更严格。
STACKOVERFLOW_API_KEY=
# 知乎 MCP（SSE）Bearer Token。
ZHIHU_ACCESS_SECRET=
# Hugging Face：留空时工具可列出但调用受限。
HF_TOKEN=

# ---- 调试开关（一般不用填）----
# Mock Provider 的响应延迟缩放，默认 1.0；设 0 可让 Mock 立即返回。
# CROSSLLM_MOCK_DELAY_SCALE=0
# 故障注入：设置为某个 model_id，让该模型本轮返回失败，用于验证错误隔离路径。
# CROSSLLM_FAIL_MODEL=
